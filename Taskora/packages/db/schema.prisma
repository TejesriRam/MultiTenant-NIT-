// schema.prisma
// Reference schema — adapt field names to match your existing migration history.
// Key additions / fixes annotated with "// FIX:" comments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

// FIX: All log actions the system emits — must match LogAction in @/types
enum LogAction {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_RESTORED
  MEMBER_ADDED
  ROLE_UPDATED
  MEMBER_REMOVED
}

enum EntityType {
  TASK
  MEMBER
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  tasks        Task[]       @relation("TaskCreatedBy")
  activityLogs ActivityLog[] @relation("LogActor")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  tasks        Task[]
  activityLogs ActivityLog[]
}

model Membership {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(MEMBER)
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  organizationId String
  createdById    String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // FIX: deletedAt is required for soft-delete / Trash functionality.
  // Without this field, remove() has nowhere to write and trash() cannot filter.
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
}

model ActivityLog {
  id             String     @id @default(cuid())
  actorId        String
  organizationId String
  action         LogAction
  entityType     EntityType
  entityId       String
  // FIX: metadata must be Json (not String) so the frontend can read
  // structured key-value pairs without manual parsing.
  metadata       Json       @default("{}")
  createdAt      DateTime   @default(now())

  actor        User         @relation("LogActor",       fields: [actorId],        references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action])
  @@index([entityId])
}
